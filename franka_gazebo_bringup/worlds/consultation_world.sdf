<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="consultation_world">
    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Table (Center) -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="surface"><geometry><box><size>0.8 1.2 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.2 0.05</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
        <!-- Table legs -->
        <visual name="leg1_vis"><pose>0.35 0.55 -0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg2_vis"><pose>-0.35 0.55 -0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg3_vis"><pose>0.35 -0.55 -0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="leg4_vis"><pose>-0.35 -0.55 -0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Doctor (Seated) -->
    <model name="doctor_station">
      <static>true</static>
      <!-- Placed on one side of the table (Y = 0.85), rotated to face the table and patient (-Y direction) -->
      <pose>0.5 0.85 0 0 0 -1.570796</pose>
      <link name="link">
        <!-- Chair -->
        <visual name="chair_seat"><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.05</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="chair_back"><pose>-0.175 0 0.65 0 0 0</pose><geometry><box><size>0.05 0.4 0.5</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="chair_leg1"><pose>0.15 0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg2"><pose>0.15 -0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg3"><pose>-0.15 0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg4"><pose>-0.15 -0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        
        <!-- Doctor Body (White Coat) -->
        <visual name="torso"><pose>-0.05 0 0.7 0 0 0</pose><geometry><box><size>0.2 0.35 0.55</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="head"><pose>-0.05 0 1.1 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.9 0.7 0.6 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material></visual>
        <visual name="thighs"><pose>0.15 0 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 0.15</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="calves"><pose>0.25 0 0.25 0 0 0</pose><geometry><box><size>0.15 0.3 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Patient (Seated) -->
    <model name="patient_station">
      <static>true</static>
      <!-- Placed on the opposite side of the table (Y = -0.85), rotated to face the table and doctor (+Y direction) -->
      <pose>0.5 -0.85 0 0 0 1.570796</pose>
      <link name="link">
        <!-- Chair -->
        <visual name="chair_seat"><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.05</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient></material></visual>
        <visual name="chair_back"><pose>-0.175 0 0.65 0 0 0</pose><geometry><box><size>0.05 0.4 0.5</size></box></geometry><material><ambient>0.3 0.2 0.1 1</ambient></material></visual>
        <visual name="chair_leg1"><pose>0.15 0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg2"><pose>0.15 -0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg3"><pose>-0.15 0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <visual name="chair_leg4"><pose>-0.15 -0.15 0.2 0 0 0</pose><geometry><box><size>0.05 0.05 0.4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        
        <!-- Patient Body (Blue Clothes) -->
        <visual name="torso"><pose>-0.05 0 0.7 0 0 0</pose><geometry><box><size>0.2 0.35 0.55</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <visual name="head"><pose>-0.05 0 1.1 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.9 0.7 0.6 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material></visual>
        <visual name="thighs"><pose>0.15 0 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 0.15</size></box></geometry><material><ambient>0.1 0.2 0.4 1</ambient></material></visual>
        <visual name="calves"><pose>0.25 0 0.25 0 0 0</pose><geometry><box><size>0.15 0.3 0.4</size></box></geometry><material><ambient>0.1 0.2 0.4 1</ambient></material></visual>
      </link>
    </model>
    
    <!-- Dynamic Object on Table (e.g., Medicine Box or Medical Record) -->
    <model name="medical_item">
      <pose>0.5 0.1 0.43 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.15 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.15 0.02</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
